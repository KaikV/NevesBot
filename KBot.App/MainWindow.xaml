<Window x:Class="KBot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KBot | NevesBot" Icon="/KBot.App;component/assets/logo.png"
        Height="760" Width="1180" MinHeight="650" MinWidth="960"
        FontFamily="Segoe UI" Background="{DynamicResource WindowBackground}" Closed="OnClosed">
    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ElevatedBackground}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#FF173B50" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" Padding="18,25"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="54" Height="54" Stretch="Uniform" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Source>
                            <BitmapImage UriSource="/KBot.App;component/assets/logo.png" DecodePixelWidth="128" />
                        </Image.Source>
                    </Image>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                        <TextBlock Text="KBOT" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}" />
                        <TextBlock Text="NEVESBOT" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="MONITORAMENTO" Foreground="{DynamicResource MutedText}"
                               FontSize="10" FontWeight="Bold" Margin="14,0,0,7" />
                    <ToggleButton Content="Início" Style="{StaticResource NavigationButtonStyle}"
                                  Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                  IsChecked="{Binding IsDashboardSelected, Mode=OneWay}" />
                    <TextBlock Text="AUTOMAÇÃO" Foreground="{DynamicResource MutedText}"
                               FontSize="10" FontWeight="Bold" Margin="14,16,0,7" />
                    <ToggleButton Content="Alvo" Style="{StaticResource NavigationButtonStyle}"
                                  Command="{Binding NavigateCommand}" CommandParameter="Target"
                                  IsChecked="{Binding IsTargetSelected, Mode=OneWay}" />
                    <ToggleButton Content="Cura" Style="{StaticResource NavigationButtonStyle}"
                                  Command="{Binding NavigateCommand}" CommandParameter="Healing"
                                  IsChecked="{Binding IsHealingSelected, Mode=OneWay}" />
                    <ToggleButton Content="Captura" Style="{StaticResource NavigationButtonStyle}"
                                  Command="{Binding NavigateCommand}" CommandParameter="Catch"
                                  IsChecked="{Binding IsCatchSelected, Mode=OneWay}" />
                    <ToggleButton Content="Coleta" Style="{StaticResource NavigationButtonStyle}"
                                  Command="{Binding NavigateCommand}" CommandParameter="Loot"
                                  IsChecked="{Binding IsLootSelected, Mode=OneWay}" />
                    <ToggleButton Content="Pesca" Style="{StaticResource NavigationButtonStyle}"
                                  Command="{Binding NavigateCommand}" CommandParameter="Fishing"
                                  IsChecked="{Binding IsFishingSelected, Mode=OneWay}" />
                    <ToggleButton Content="Rota" Style="{StaticResource NavigationButtonStyle}"
                                  Command="{Binding NavigateCommand}" CommandParameter="CaveBot"
                                  IsChecked="{Binding IsCaveBotSelected, Mode=OneWay}" />
                    <ToggleButton Content="Alertas" Style="{StaticResource NavigationButtonStyle}"
                                  Command="{Binding NavigateCommand}" CommandParameter="Alerts"
                                  IsChecked="{Binding IsAlertsSelected, Mode=OneWay}" />
                    <TextBlock Text="SISTEMA" Foreground="{DynamicResource MutedText}"
                               FontSize="10" FontWeight="Bold" Margin="14,16,0,7" />
                    <ToggleButton Content="Configurações" Style="{StaticResource NavigationButtonStyle}"
                                  Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                  IsChecked="{Binding IsSettingsSelected, Mode=OneWay}" />
                </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Background="{DynamicResource ElevatedBackground}"
                        CornerRadius="9" Padding="13" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="INTEGRAÇÃO EM ANDAMENTO" Foreground="{DynamicResource AccentBrush}"
                                   FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="Configure os módulos aqui. A execução no jogo depende da integração com o cliente."
                                   Foreground="{DynamicResource MutedText}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30,26,26,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="NEVESBOT  /  WORKSPACE" Foreground="{DynamicResource AccentBrush}"
                           FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Text="{Binding CurrentSectionTitle}" Foreground="{DynamicResource PrimaryText}"
                           FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CurrentSectionDescription}" Foreground="{DynamicResource MutedText}"
                           FontSize="13" Margin="0,5,0,0" />
            </StackPanel>
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>
