<Window x:Class="KBot.App.Views.ClientFoundWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cliente encontrado" Width="440" Height="260" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource WindowBackground}">
    <StackPanel Margin="24">
        <TextBlock Text="CLIENTE ENCONTRADO" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
        <TextBlock Text="Encontramos um cliente em execução." Foreground="{DynamicResource PrimaryText}" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,14"/>
        <TextBlock x:Name="ClientText" Foreground="{DynamicResource PrimaryText}" FontSize="14"/>
        <TextBlock x:Name="PidText" Foreground="{DynamicResource MutedText}" Margin="0,4,0,24"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="ABRIR OUTRO" Click="OtherClick" Margin="0,0,8,0"/>
            <Button Content="CONECTAR AO CLIENTE" Click="ConnectClick" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </StackPanel>
</Window>
