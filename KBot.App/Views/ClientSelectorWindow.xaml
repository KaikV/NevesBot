<Window x:Class="KBot.App.Views.ClientSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seus clientes" Width="620" Height="470" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource WindowBackground}">
    <Border Padding="24" Background="{DynamicResource ElevatedBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeaderText" Text="SEUS CLIENTES" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="HeadingText" Text="Escolha uma instalação para abrir" Foreground="{DynamicResource PrimaryText}" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <ListBox x:Name="ClientsList" Height="160" SelectionChanged="ClientSelectionChanged" DisplayMemberPath="Name"/>
                <TextBlock x:Name="ClientPathText" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,8,0,12">
                <Button x:Name="AddClientButton" Content="+ Adicionar cliente" Click="AddClick" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                <StackPanel x:Name="AddPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="LOCALIZAR LAUNCHER" Click="BrowseClick" Margin="0,0,8,0"/>
                    <Button x:Name="FolderButton" Content="LOCALIZAR PASTA" Click="FolderClick"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="CancelClick" Margin="0,0,8,0"/>
                <Button x:Name="OpenButton" Content="ABRIR" Click="OpenClick" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
