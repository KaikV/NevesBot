<UserControl x:Class="KBot.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KBot.App.Controls"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,24">
            <controls:CardControl Title="GAME SESSION" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{Binding ClientName}" Foreground="{DynamicResource PrimaryText}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SessionMessage}" Foreground="{DynamicResource AccentBrush}" FontSize="14" Margin="0,8,0,12" TextWrapping="Wrap"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CLIENTE" Foreground="{DynamicResource MutedText}" FontSize="11"/>
                            <TextBlock Text="{Binding SessionExecutable}" Foreground="{DynamicResource PrimaryText}" FontSize="15" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PID" Foreground="{DynamicResource MutedText}" FontSize="11"/>
                            <TextBlock Text="{Binding SessionPidText}" Foreground="{DynamicResource PrimaryText}" FontSize="15" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding OpenClientLabel}" Command="{Binding OpenSessionCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Capturar tela" Command="{Binding CaptureSessionCommand}"/>
                    </StackPanel>
                    <Expander Header="Detalhes da sessão" Margin="0,14,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding ConfiguredClientPath}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SessionHwndText, StringFormat=HWND: {0}}" Foreground="{DynamicResource MutedText}"/>
                            <TextBlock Text="{Binding ReaderDetail}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                    <Border Background="{DynamicResource WindowBackground}" CornerRadius="8" Padding="8" Margin="0,14,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSessionCapture}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image Source="{Binding SessionCapture}" MaxHeight="220" Stretch="Uniform"/>
                    </Border>
                </StackPanel>
            </controls:CardControl>

            <Expander Header="Diagnóstico" Margin="0,0,0,18">
                <StackPanel>
            <Border Background="{DynamicResource ElevatedBackground}" BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ESTADO DA CONEXÃO" Foreground="{DynamicResource AccentBrush}"
                                   FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource PrimaryText}"
                                   FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,8,18,7" />
                        <TextBlock Text="O painel verifica o núcleo a cada segundo enquanto esta página está aberta."
                                    Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" FontSize="12" />
                        <Border Background="{DynamicResource WindowBackground}" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowCalibration}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="RECALIBRADOR DE OFFSET (AUTOMÁTICO)" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding CalibrationStatus}" Foreground="{DynamicResource MutedText}"
                                               TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Recalibrar agora" VerticalAlignment="Center"
                                        Command="{Binding CalibrateOffsetCommand}" />
                            </Grid>
                        </Border>
                        <Border Background="{DynamicResource WindowBackground}" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSession}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="DIAGNOSTICO DE FORMATO DE POSICAO" Foreground="{DynamicResource AccentBrush}"
                                           FontSize="10" FontWeight="Bold" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="valor do minimap (opcional):" Foreground="{DynamicResource MutedText}"
                                               FontSize="12" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center" Height="26"
                                             Text="{Binding MinimapReference, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Cole o numero que aparece no minimap (ex.: 2962.2283). O bot compara com a memoria." />
                                    <Button Grid.Column="2" Content="Diagnosticar" VerticalAlignment="Center"
                                            Command="{Binding DiagnosePositionCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding ProbeReport}" Foreground="{DynamicResource PrimaryText}"
                                           FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasProbeReport}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Iniciar núcleo" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartCoreCommand}" IsEnabled="{Binding CanStartCore}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:CardControl Grid.Column="0" Title="NÚCLEO NATIVO" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25CF;" FontSize="18" Margin="0,0,9,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NativeOnline}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding CoreStatusText}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}" />
                    </StackPanel>
                </controls:CardControl>
                <controls:CardControl Grid.Column="1" Title="CLIENTE DO JOGO" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25CF;" FontSize="18" Margin="0,0,9,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClientConnected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ClientStatusText}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}" />
                    </StackPanel>
                </controls:CardControl>
                <controls:CardControl Grid.Column="2" Title="LEITURA DE STATUS">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25CF;" FontSize="18" Margin="0,0,9,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding MonitorStatusText}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}" />
                    </StackPanel>
                </controls:CardControl>
            </Grid>

            <controls:CardControl Title="DETALHES DO CLIENTE" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="EXECUTÁVEL" Foreground="{DynamicResource MutedText}" FontSize="11" />
                        <TextBlock Text="{Binding ProcessName}" Foreground="{DynamicResource PrimaryText}"
                                   FontSize="16" Margin="0,7,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="PID" Foreground="{DynamicResource MutedText}" FontSize="11" />
                        <TextBlock Text="{Binding ProcessId, TargetNullValue=—}" Foreground="{DynamicResource PrimaryText}"
                                   FontSize="16" Margin="0,7,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ÚLTIMA VERIFICAÇÃO" Foreground="{DynamicResource MutedText}" FontSize="11" />
                        <TextBlock Text="{Binding LastUpdate, StringFormat={}{0:HH:mm:ss}, TargetNullValue=—}"
                                   Foreground="{DynamicResource PrimaryText}" FontSize="16" Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>
            </controls:CardControl>

            <controls:CardControl Title="POSIÇÃO DO PERSONAGEM" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="COORDENADAS X, Y, Z" Foreground="{DynamicResource MutedText}" FontSize="11" />
                        <TextBlock Text="{Binding PositionText}" Foreground="{DynamicResource AccentBrush}"
                                   FontSize="22" FontWeight="SemiBold" Margin="0,7,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource WindowBackground}" CornerRadius="8" Padding="8" VerticalAlignment="Center">
                        <TextBlock Text="Leitura pelo núcleo (ReadProcessMemory)." Foreground="{DynamicResource MutedText}"
                                   FontSize="11" TextWrapping="Wrap" MaxWidth="240" />
                    </Border>
                </Grid>
            </controls:CardControl>

            <controls:CardControl Title="AUTOMAÇÃO (BRAIN)" Margin="0,0,0,18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x25CF;" FontSize="18" Margin="0,0,9,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BrainActive}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Última ação:" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding BotActionLog}" Foreground="{DynamicResource PrimaryText}"
                                   FontSize="14" Margin="10,0,0,0" TextWrapping="Wrap"/>
                    </Grid>
                    <TextBlock Text="{Binding BotSignalSummary, StringFormat=Sinais: {0}}"
                               Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding BotPendingCommand, StringFormat=Aguardando offset: {0}}"
                               Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </controls:CardControl>
                </StackPanel>
            </Expander>

            <controls:CardControl Title="PRÓXIMOS PASSOS">
                <StackPanel>
                    <TextBlock Text="A base de conexão está pronta para receber os módulos de automação."
                               Foreground="{DynamicResource PrimaryText}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Edite rotas no Cavebot e salve suas opções em cada módulo. A execução de alvos, revive, magias, pesca, captura, coleta e alertas depende da integração com o cliente atual."
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,8,0,0" />
                    <TextBlock Text="Automação ativa: nenhuma" Foreground="{DynamicResource WarningBrush}"
                               FontWeight="SemiBold" Margin="0,16,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Editar rotas" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="CaveBot" Margin="0,0,8,0" />
                        <Button Content="Abrir configurações" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="Settings" />
                    </StackPanel>
                </StackPanel>
            </controls:CardControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
