<UserControl x:Class="KBot.App.Views.HealingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KBot.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,24">
            <Border Background="{DynamicResource ElevatedBackground}" BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="CURA" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Revive, cura de status e a ordem dos remédios."
                                   Foreground="{DynamicResource PrimaryText}" FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,7,0,5" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Salvar perfil" Command="{Binding SaveCommand}" VerticalAlignment="Center"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>

            <controls:CardControl Title="REVIVE E COMIDA" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox Content="Reviver sozinho" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding AutoReviveEnabled}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="Usar comida automaticamente" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding FoodEnabled}"
                              Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="HP PARA REVIVE" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding ReviveHp, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="HP FORA DA BATALHA" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding ReviveOutOfBattleHp, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="TECLA DE REVIVE" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding ReviveItemHotkey, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="TECLA DE COMIDA" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding FoodHotkey, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </controls:CardControl>

            <controls:CardControl Title="CURA DE STATUS E HP" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox Content="Curar status (envenenado/dormindo/etc.)" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding AutoMedicine}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="Curar o HP do jogador" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding HealPlayer}"
                              Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="CURAR ABAIXO DE (%)" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding CureAtPercent, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="TECLA DE REMÉDIO" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding MedicineHotkey, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TECLA DE CURA" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding HealHotkey, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="HP DO PERSONAGEM (%)" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding PlayerHealPercent, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="COOLDOWN DE CURA (MS)" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding HealingCooldownMs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Content="Curar somente fora de batalha" Style="{StaticResource ToggleOptionStyle}"
                                  IsChecked="{Binding HealOnlyOutOfBattle}" VerticalAlignment="Bottom" />
                    </Grid>
                </StackPanel>
            </controls:CardControl>

            <controls:CardControl Title="MAGIAS E COOLDOWNS" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Ajuste as teclas F1 a F9 e o intervalo mínimo, em segundos."
                               Foreground="{DynamicResource MutedText}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Spells}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" /><ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Foreground="{DynamicResource PrimaryText}"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <CheckBox Grid.Column="1" Content="Usar" IsChecked="{Binding Enabled}"
                                              Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding CooldownText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="3" Text="segundos" Foreground="{DynamicResource MutedText}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:CardControl>
            <TextBlock Text="{Binding Feedback}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="2,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
