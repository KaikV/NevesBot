<UserControl x:Class="KBot.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KBot.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,24">
            <Border Background="{DynamicResource ElevatedBackground}" BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock x:Name="SectionEyebrow" Text="PERFIL DE AUTOMAÇÃO" Foreground="{DynamicResource AccentBrush}"
                                   FontSize="11" FontWeight="Bold" />
                        <TextBlock x:Name="SectionHeading" Text="Configure os recursos do KBot em um perfil local."
                                   Foreground="{DynamicResource PrimaryText}" FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,7,0,5" />
                        <TextBlock Text="Salvar o perfil não ativa ações no jogo. Os módulos ainda precisam da integração com o cliente atual."
                                   Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ImportButton" Content="Importar perfil JSON" Command="{Binding ImportCommand}" Margin="0,0,8,0" />
                        <Button x:Name="ExportCodeButton" Content="Exportar código" Command="{Binding ExportCodeCommand}" Margin="0,0,8,0"
                                ToolTip="Gera uma linha de texto com sua configuração para passar a um amigo." />
                        <Button x:Name="ImportCodeButton" Content="Importar código" Command="{Binding ImportCodeCommand}" Margin="0,0,8,0"
                                ToolTip="Cole um código recebido de outro jogador para aplicar a configuração dele." />
                        <Button Content="Salvar perfil" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <controls:CardControl x:Name="TargetsCard" Title="PRIORIDADE DE ALVOS" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox Content="Selecionar alvos automaticamente" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding AttackerEnabled}"
                              Margin="0,0,0,12" />
                    <TextBlock Text="A ordem define quais criaturas terão prioridade quando o módulo de alvos estiver pronto."
                               Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid>
                        <ListBox ItemsSource="{Binding Monsters}" SelectedItem="{Binding SelectedMonster}"
                                 Height="120" Background="{DynamicResource WindowBackground}"
                                 Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource CardBorder}" />
                        <TextBlock Text="Nenhum alvo no perfil. Adicione o nome de uma criatura."
                                   Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   MaxWidth="400" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Monsters.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBox Width="220" Text="{Binding NewMonster, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0" ToolTip="Nome exato da criatura" />
                        <Button Content="Adicionar" Command="{Binding AddMonsterCommand}" Margin="0,0,8,0" />
                        <Button Content="Subir" Command="{Binding MoveMonsterUpCommand}"
                                IsEnabled="{Binding HasSelectedMonster}" Margin="0,0,8,0" />
                        <Button Content="Descer" Command="{Binding MoveMonsterDownCommand}"
                                IsEnabled="{Binding HasSelectedMonster}" Margin="0,0,8,0" />
                        <Button Content="Remover" Command="{Binding RemoveMonsterCommand}"
                                IsEnabled="{Binding HasSelectedMonster}" />
                    </StackPanel>
                </StackPanel>
            </controls:CardControl>

            <controls:CardControl x:Name="HealingCard" Title="REVIVE E COMIDA" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox Content="Reviver sozinho" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding AutoReviveEnabled}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="Usar comida automaticamente" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding FoodEnabled}"
                              Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="HP PARA REVIVE" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding ReviveHp, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="HP FORA DA BATALHA" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding ReviveOutOfBattleHp, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="TECLA DE REVIVE" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding ReviveItemHotkey, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="TECLA DE COMIDA" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding FoodHotkey, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </controls:CardControl>

            <controls:CardControl x:Name="SpellsCard" Title="MAGIAS E COOLDOWNS" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Ajuste as teclas F1 a F9 e o intervalo mínimo, em segundos."
                               Foreground="{DynamicResource MutedText}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Spells}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" /><ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Foreground="{DynamicResource PrimaryText}"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <CheckBox Grid.Column="1" Content="Usar" IsChecked="{Binding Enabled}"
                                              Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding CooldownText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="3" Text="segundos" Foreground="{DynamicResource MutedText}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:CardControl>

            <controls:CardControl x:Name="AlertsCard" Title="ALERTAS E HOTKEYS" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox Content="Alertas de mensagens" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding AlertsEnabled}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="Atalhos manuais" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding HotkeysEnabled}"
                              Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="REVIVE MANUAL" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding ManualReviveHotkey, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="PAUSAR CAVEBOT" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding PauseCavebotHotkey, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PAUSAR ATAQUE" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding PauseAttackerHotkey, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </controls:CardControl>
            <controls:CardControl x:Name="FishingCard" Title="PESCA" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Defina o ponto de pesca na tela e o atalho correspondente. As coordenadas são pixels da tela."
                               Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <CheckBox Content="Pescar sozinho" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding FishingEnabled}"
                              Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="POSIÇÃO X" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding FishingX, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="POSIÇÃO Y" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding FishingY, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ATALHO DE PESCA" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding FishingHotkey, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </controls:CardControl>
            <controls:CardControl x:Name="CatchCard" Title="CAPTURA" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Guarde a preferência e o atalho de captura no perfil. A detecção do alvo ainda precisa ser conectada ao cliente."
                               Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <CheckBox Content="Capturar automaticamente" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding CatchEnabled}"
                              Margin="0,0,0,12" />
                    <TextBlock Text="ATALHO DE CAPTURA" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                    <TextBox Text="{Binding CatchHotkey, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left" />
                </StackPanel>
            </controls:CardControl>
            <controls:CardControl x:Name="LootCard" Title="COLETA" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Guarde a preferência e o atalho de coleta no perfil. O reconhecimento dos objetos ainda precisa ser conectado ao cliente."
                               Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <CheckBox Content="Coletar automaticamente" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding LootEnabled}"
                              Margin="0,0,0,12" />
                    <TextBlock Text="ATALHO DE COLETA" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                    <TextBox Text="{Binding LootHotkey, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left" />
                </StackPanel>
            </controls:CardControl>
            <controls:CardControl x:Name="DiagnoseCard" Title="DIAGNÓSTICO" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Conferência do que falta para cada recurso funcionar. Não muda comportamento, só mostra."
                               Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Diagnostics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="6,2" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Background" Value="#1E4F38" />
                                                    <Setter Property="Foreground" Value="#7BE3A5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="ATENÇÃO">
                                                            <Setter Property="Background" Value="#5A3A14" />
                                                            <Setter Property="Foreground" Value="#FFC66B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Feature}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource MutedText}"
                                               TextWrapping="Wrap" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Verificar agora" Command="{Binding DiagnoseCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                </StackPanel>
            </controls:CardControl>
            <TextBlock Text="{Binding Feedback}" Foreground="{DynamicResource AccentBrush}"
                       TextWrapping="Wrap" Margin="2,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
