<UserControl x:Class="KBot.App.Views.TargetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KBot.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,24">
            <Border Background="{DynamicResource ElevatedBackground}" BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="ALVO" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Defina o que ataca, em que ordem e como o bot luta."
                                   Foreground="{DynamicResource PrimaryText}" FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,7,0,5" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Salvar perfil" Command="{Binding SaveCommand}" VerticalAlignment="Center"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>

            <controls:CardControl Title="COMO O BOT ATAQUE" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox Content="Atacar alvos automaticamente" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding AttackerEnabled}"
                              Margin="0,0,0,10" />
                    <CheckBox Content="Combo em área (vários de uma vez)" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding AreaCombo}"
                              Margin="0,0,0,10" />
                    <CheckBox Content="Atacar o alvo (um por um)" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding AttackOneByOne}"
                              Margin="0,0,0,10" />
                    <CheckBox Content="Soltar poke sozinho quando o campo fica vazio" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding AutoSummon}"
                              Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="SLOT DO POKE" Foreground="{DynamicResource MutedText}" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" Text="{Binding ActiveSlot, UpdateSourceTrigger=PropertyChanged}" ToolTip="0 = manter atual" />
                        <TextBlock Grid.Column="2" Text="0 mantém o pokemon atual; 1 a 6 escolhe o slot."
                                   Foreground="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                </StackPanel>
            </controls:CardControl>

            <controls:CardControl Title="MOVIMENTO E FILTROS" Margin="0,0,0,16">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,12">
                        <CheckBox Content="Mover para o alvo" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding TargetMoveEnabled}" Margin="0,0,20,8" />
                        <CheckBox Content="Aproximar até a distância" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding TargetApproachEnabled}" Margin="0,0,20,8" />
                        <CheckBox Content="Seguir durante a batalha" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding TargetFollowInBattle}" Margin="0,0,20,8" />
                        <CheckBox Content="Priorizar raros/shiny" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding RareFirst}" Margin="0,0,20,8" />
                        <CheckBox Content="Pausar rota ao encontrar alvo" Style="{StaticResource ToggleOptionStyle}" IsChecked="{Binding PauseRouteOnTarget}" Margin="0,0,0,8" />
                    </WrapPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="ALCANCE (SQM)" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding AttackRange, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="INTERVALO DE MOVIMENTO (MS)" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding TargetMoveIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MANTER DISTÂNCIA (SQM)" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                            <TextBox Text="{Binding TargetKeepDistance, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="PALAVRAS DE RARIDADE (VÍRGULA)" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                    <TextBox Text="{Binding RareWords, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <TextBlock Text="CRIATURAS IGNORADAS (VÍRGULA)" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="0,0,0,5" />
                    <TextBox Text="{Binding IgnoredMonsters, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </controls:CardControl>

            <controls:CardControl Title="PRIORIDADE DE ALVOS" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="A ordem define quais criaturas entram primeiro na seleção."
                               Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid>
                        <ListBox ItemsSource="{Binding Monsters}" SelectedItem="{Binding SelectedMonster}"
                                 Height="120" Background="{DynamicResource WindowBackground}"
                                 Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource CardBorder}" />
                        <TextBlock Text="Nenhum alvo no perfil. Adicione o nome de uma criatura."
                                   Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   MaxWidth="400" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Monsters.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBox Width="220" Text="{Binding NewMonster, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0" ToolTip="Nome exato da criatura" />
                        <Button Content="Adicionar" Command="{Binding AddMonsterCommand}" Margin="0,0,8,0" />
                        <Button Content="Subir" Command="{Binding MoveMonsterUpCommand}"
                                IsEnabled="{Binding HasSelectedMonster}" Margin="0,0,8,0" />
                        <Button Content="Descer" Command="{Binding MoveMonsterDownCommand}"
                                IsEnabled="{Binding HasSelectedMonster}" Margin="0,0,8,0" />
                        <Button Content="Remover" Command="{Binding RemoveMonsterCommand}"
                                IsEnabled="{Binding HasSelectedMonster}" />
                    </StackPanel>
                </StackPanel>
            </controls:CardControl>
            <TextBlock Text="{Binding Feedback}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="2,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
