<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <KBotAppOutput Condition="'$(KBotAppOutput)' == ''">Review</KBotAppOutput>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="KBot.App">
      <HintPath>..\KBot.App\bin\$(KBotAppOutput)\KBot.App.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
